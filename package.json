{
  "name": "@buildproven/mcp-oauth",
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/server": "^2.4.0",
    "@types/node": "^26.6.7",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.1"
  },
  "description": "Owner-only OAuth 2.1 authorization server and token checks for hosted MCP endpoints",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buildproven/mcp-oauth.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "dependencies": {
    "jose": "^6.2.18"
  },
  "peerDependencies": {
    "@modelcontextprotocol/server": "^2.4.0"
  }
}
